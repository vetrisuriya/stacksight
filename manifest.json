{
  "manifest_version": 3,
  "name": "StackSight",
  "short_name": "StackSight",
  "version": "1.0.0",
  "description": "Instantly discover the technology behind any website. Detect CMS, frameworks, analytics, CDN, cloud providers, and security headers.",

  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "StackSight – Tech Detector",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
